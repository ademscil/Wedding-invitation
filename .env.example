# Database — PostgreSQL connection string (e.g. from Neon, Supabase, or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth — set both to enable "Masuk dengan Google".
# The button appears automatically once these are filled in; there is no
# separate toggle, so the button can never be shown for a provider that is
# not actually configured.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Uploadthing (file uploads) — get token from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=""

# Email — pick ONE backend. SMTP wins when both are set.
#
# Option A (no domain needed): SMTP with a provider that verifies a single
# sender address — Brevo (free 300/day, https://app.brevo.com/settings/keys/smtp),
# Mailjet, or a Gmail app password (https://myaccount.google.com/apppasswords).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Option B (needs a domain you own): Resend — https://resend.com/api-keys.
# Its sandbox sender onboarding@resend.dev only delivers to the Resend account
# owner's own address, so it CANNOT be used to send password resets to
# customers. Verify a domain first, or use Option A.
RESEND_API_KEY=""

# The From: address, used by whichever backend is active. Must be an address the
# provider has verified, otherwise mail is rejected or filed as spam.
EMAIL_FROM="WedInvite <onboarding@resend.dev>"

# Payment Gateway (Midtrans) — get sandbox keys from https://dashboard.sandbox.midtrans.com/settings/access-keys
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="WedInvite"

# Support contact, published on the legal pages and in the footer.
# Payment gateways check that a merchant is reachable.
NEXT_PUBLIC_SUPPORT_EMAIL="support@wedinvite.id"
NEXT_PUBLIC_SUPPORT_WHATSAPP="6281234567890"
