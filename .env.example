# ---------------------------------------------------------------------------
# WedInvite — environment configuration
# Copy this file to .env.local and fill in the values you need.
# Only DATABASE_URL and NEXTAUTH_SECRET are required to run locally.
# ---------------------------------------------------------------------------

# Database
# SQLite for development. For production switch the datasource provider in
# prisma/schema.prisma to "postgresql" and put the connection string here.
DATABASE_URL="file:./dev.db"

# NextAuth — REQUIRED
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth (optional)
# Leave empty to hide the "Sign in with Google" button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Payments (Midtrans)
# ---------------------------------------------------------------------------
# Leave the keys empty during development and set PAYMENT_DEMO_MODE=true to
# simulate successful upgrades without a gateway.
#
# PAYMENT_DEMO_MODE is refused when NODE_ENV=production or when
# MIDTRANS_IS_PRODUCTION=true, so it can never hand out paid plans on a live
# deployment.
PAYMENT_DEMO_MODE="true"

MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Client key is exposed to the browser for the Snap payment widget.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"

# Webhook: point Midtrans "Payment Notification URL" at
#   https://your-domain.com/api/webhooks/payment

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------

# File uploads (UploadThing)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# Transactional email (Resend)
RESEND_API_KEY=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="WedInvite"

# Seed an admin account with `npm run db:seed`.
# Change these before seeding anything you expose publicly.
SEED_ADMIN_EMAIL="admin@wedinvite.local"
SEED_ADMIN_PASSWORD="admin12345"
